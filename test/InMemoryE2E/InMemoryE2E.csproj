    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Elf.ObjectStorageAsset.InMemoryE2E</AssemblyName>
    <RootNamespace>Elf.ObjectStorageAsset.InMemoryE2E</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Bootstrap\Bootstrap.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\Infrastructure.csproj" />
    <ProjectReference Include="..\TestSupport\TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="[$(OsaEfCoreVersion),$(OsaEfCoreUpperBound))" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(OsaMinioExtensionsVersion)" />
  </ItemGroup>

</Project>
