<Project>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/AbuDawood/ObjectStorageAsset</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/AbuDawood/ObjectStorageAsset</PackageProjectUrl>
    <PackageTags>object-storage;minio;ef-core;dotnet</PackageTags>
    <Authors>ObjectStorageAsset contributors</Authors>
    <Copyright>Copyright (c) 2026 ObjectStorageAsset contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <NormalizedProjectDirectory>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))</NormalizedProjectDirectory>
    <NormalizedSrcDirectory>$([System.String]::Copy('$(MSBuildThisFileDirectory)src').Replace('\', '/'))</NormalizedSrcDirectory>
    <IsSrcProject>false</IsSrcProject>
    <IsSrcProject Condition="$([System.String]::Copy('$(NormalizedProjectDirectory)').StartsWith('$(NormalizedSrcDirectory)'))">true</IsSrcProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSrcProject)' == 'true'">
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>0.1.1</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSrcProject)' != 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSrcProject)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" Link="LICENSE" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Link="README.md" />
  </ItemGroup>
</Project>
