<Project>
  <PropertyGroup>
    <!-- EF bulk-update signatures are binary-incompatible across these major versions. -->
    <OsaEfCoreVersion>8.0.11</OsaEfCoreVersion>
    <OsaEfCoreUpperBound>9.0.0</OsaEfCoreUpperBound>
    <OsaExtensionsVersion>8.0.0</OsaExtensionsVersion>
    <OsaExtensionsAbstractionsVersion>8.0.2</OsaExtensionsAbstractionsVersion>
    <!-- MinIO 7 already requires Extensions 9 on its net8.0 target; retain that boundary. -->
    <OsaMinioExtensionsVersion>9.0.4</OsaMinioExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <OsaEfCoreVersion>10.0.15</OsaEfCoreVersion>
    <OsaEfCoreUpperBound>11.0.0</OsaEfCoreUpperBound>
    <OsaExtensionsVersion>10.0.15</OsaExtensionsVersion>
    <OsaExtensionsAbstractionsVersion>10.0.15</OsaExtensionsAbstractionsVersion>
    <OsaMinioExtensionsVersion>10.0.15</OsaMinioExtensionsVersion>
  </PropertyGroup>
  <PropertyGroup>
    <RepositoryUrl>https://github.com/AbuDawood/ObjectStorageAsset</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageProjectUrl>https://github.com/AbuDawood/ObjectStorageAsset</PackageProjectUrl>
    <PackageTags>object-storage;minio;ef-core;dotnet</PackageTags>
    <Authors>ObjectStorageAsset contributors</Authors>
    <Copyright>Copyright (c) 2026 ObjectStorageAsset contributors</Copyright>
  </PropertyGroup>

  <PropertyGroup>
    <NormalizedProjectDirectory>$([System.String]::Copy('$(MSBuildProjectDirectory)').Replace('\', '/'))</NormalizedProjectDirectory>
    <NormalizedSrcDirectory>$([System.String]::Copy('$(MSBuildThisFileDirectory)src').Replace('\', '/'))</NormalizedSrcDirectory>
    <IsSrcProject>false</IsSrcProject>
    <IsSrcProject Condition="$([System.String]::Copy('$(NormalizedProjectDirectory)').StartsWith('$(NormalizedSrcDirectory)'))">true</IsSrcProject>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSrcProject)' == 'true'">
    <IsPackable>true</IsPackable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <VersionPrefix>0.2.2</VersionPrefix>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsSrcProject)' != 'true'">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsSrcProject)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="\" Visible="false" Link="LICENSE" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Link="README.md" />
  </ItemGroup>
</Project>
