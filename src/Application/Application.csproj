<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Helpers\Helpers.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="[$(OsaEfCoreVersion),$(OsaEfCoreUpperBound))" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(OsaExtensionsAbstractionsVersion)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Elf.ObjectStorageAsset.Application</PackageId>
    <Description>Abstractions and application contracts for Elf.ObjectStorageAsset.</Description>
    <AssemblyName>Elf.ObjectStorageAsset.Application</AssemblyName>
    <RootNamespace>Elf.ObjectStorageAsset.Application</RootNamespace>
  </PropertyGroup>

</Project>
